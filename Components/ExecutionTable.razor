@if(executions is not null)
{

    <MudTable Items="LatestExecutions" Hover="true" Striped="true" Bordered="true" Filter="new Func<Tradelog,bool>(FilterFunc)">
        <ToolBarContent>

        <div class="d-flex align-center gap-4">
            <MudToggleGroup @bind-Value="_selected" Outlined="true" Color="Color.Primary">
                <MudToggleItem Value='"ID"'>TRADE ID</MudToggleItem>
                <MudToggleItem Value='"TAKER"'>TAKER ID</MudToggleItem>
                <MudToggleItem Value='"MAKER"'>MAKER ID</MudToggleItem>
                <MudToggleItem Value='"Quantity"'>QUANTITY</MudToggleItem>
                <MudToggleItem Value='"Price"'>PRICE</MudToggleItem>
            </MudToggleGroup>

        <MudTextField @bind-Value="searchString" Placeholder=@_selected Adornment="Adornment.Start" Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </div>

        </ToolBarContent>
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>TAKER</MudTh>
            <MudTh>MAKER</MudTh>
            <MudTh>QUANTITY</MudTh>
            <MudTh>PRICE</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.log_id</MudTd>
            <MudTd DataLabel="TAKER">@context.taker_id</MudTd>
            <MudTd DataLabel="MAKER">@context.maker_id</MudTd>
            <MudTd DataLabel="QUANTITY">@context.quantity.ToString("0.00")</MudTd>
            <MudTd DataLabel="PRICE">@context.execution_price.ToString("0.00")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code
{
    [Parameter]
    public List<Tradelog> executions {get;set;} = new List<Tradelog>();

    private IEnumerable<Tradelog> LatestExecutions => (executions ?? Enumerable.Empty<Tradelog>()).Reverse();

    private string searchString = "";
    private bool FilterFunc(Tradelog log) => FilterFunc(log, searchString);

    private string _selected = "ID";
    
    private bool FilterFunc(Tradelog x, string searchString)
    {
          if (string.IsNullOrWhiteSpace(searchString))
                return true;

          var s = searchString.Trim();

          if(_selected == "ID")      
              return x.log_id.ToString().Contains(s);
          else if(_selected == "TAKER")
              return x.taker_id.ToString().Contains(s); 
          else if (_selected == "MAKER")
              return x.maker_id.ToString().Contains(s); 
          else if (_selected == "Quantity")
              return x.quantity.ToString().Contains(s); 
          else if (_selected == "Price")
              return x.execution_price.ToString().Contains(s);
          else 
              return false;
    }
}


