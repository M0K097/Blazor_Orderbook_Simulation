@page "/"
@inherits LayoutComponentBase
@inject OrderBook book
@rendermode InteractiveServer

<MudGrid>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Style="width:100%;">
        <MudStack>

            <MudText Typo="Typo.h5">
                CREATE ORDERS
            </MudText>

            <MudDivider Class="my-2" />


            <MudText>Mode: @_mode</MudText>

            <MudToggleGroup T="string" SelectionMode="SelectionMode.SingleSelection" @bind-Value="_mode" Color="Color.Primary" CheckMark FixedContent>
                <MudToggleItem Value="@("MANUAL")" Text="MANUAL" />
                <MudToggleItem Value="@("AUTO")" Text="AUTOMATIC" />
            </MudToggleGroup>

            <MudDivider Class="my-2" />

            @if(_mode == "MANUAL")
            {
                <OrderInputFields when_create_order="handle_create_order"/>
            }
            else
            {
                <AutoPlacer on_auto_create="handle_create_order"/>
            }



        </MudStack>

           </MudPaper>
    </MudItem>












</MudGrid>



@code {

    private PriceChart? pricechart;

    private string _mode = "MANUAL";


    public void handle_create_order(OrderInput input)
    {
        var i = input;
        if(i.Type == OrderType.Limit)
            book.place_limit_order(i.side,i.Quantity,i.Price);
        else if(i.Type == OrderType.Market)
            book.place_market_order(i.side,i.Quantity);
    }

}
