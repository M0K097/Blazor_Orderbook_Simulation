@page "/"
@inherits LayoutComponentBase
@inject OrderBook orderbook
@rendermode InteractiveServer
@inject IDialogService DialogService 

<MudGrid>

    <MudItem xs="6">

            <MudPaper Class="pa-4" Style="width:100%; height:600px; overflow:auto;">
                <OrderInputFields when_create_order="handle_create_order"/>
                <MudDivider Class="my-3" />
                <AutoPlacer @ref="auto_placer" on_auto_create="handle_create_order"/>
            </MudPaper>
            
    </MudItem>

    <MudItem xs="6">
        
        <MudPaper Style="width:100%; height:600px; overflow:auto;">
            <MudButton OnClick="reset_system">RESET ORDERBOOK</MudButton>
            <Book book=@orderbook />
        </MudPaper>

    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Style="width:100%;">
              <PriceChart is_zoomed="stop_autoplacer"  @ref="pricechart"/>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Style="width:100%; height:400px; overflow:auto;">
          <ExecutionTable executions="@orderbook.trade_log"/>
        </MudPaper>
    </MudItem>

</MudGrid>

@code {

    private PriceChart? pricechart;
    private AutoPlacer? auto_placer;
    private decimal last_execution_price {get;set;} = 0;
    private bool _initialized = false;

    protected override async Task OnInitializedAsync() 
    {
        orderbook.trade_happened += update_graph;
        orderbook.load_book_from_database();
        orderbook.load_trades_from_database();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;
        _initialized = true;

        List<PriceData> data_points = orderbook.trade_log
            .Select(t => new PriceData
            {
                price = t.execution_price,
                time = t.time
            })
            .ToList();

        await pricechart!.append_batch(data_points);
    }

    public void handle_create_order(OrderInput input)
    {
        var i = input;
        if(i.Type == OrderType.Limit)
        {
            orderbook.place_limit_order(i.side,i.Quantity,i.Price);
        }
        else if(i.Type == OrderType.Market)
        {
            orderbook.place_market_order(i.side,i.Quantity);
        }
    }

    public void stop_autoplacer()
    {
        if(auto_placer is not null)
            auto_placer.Stop();
    }

    public async void update_graph()
    {
        if(orderbook.trade_log.Count > 0)
        {
            var last_trade = orderbook.trade_log.Last();
            await pricechart!.add_datapoint(last_trade.execution_price,last_trade.time);
        }
    }

    public async void reset_system()
    {

         bool? result = await DialogService.ShowMessageBoxAsync(
            "Warning",
            "Resetting can not be undone!",
            yesText:"RESET!", cancelText:"Cancel");
         var choose_reset = result == null ? false : true;

        if(choose_reset)
        {
            orderbook.reset_orderbook_data();
            orderbook.reset_database();
            if(pricechart is not null)
                await pricechart.clean_chart();

            StateHasChanged();
        }
    }
}
