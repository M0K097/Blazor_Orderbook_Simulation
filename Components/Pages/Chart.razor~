@page "/charttest"
@rendermode InteractiveServer
@using ApexCharts

<div>
    <ApexChart TItem="PriceData"
               Title="Sample Data" 
               Width="600"
               Height="600" >

        <ApexPointSeries TItem="PriceData"
                         Items="Data"
                         Name="Price"
                         SeriesType="SeriesType.Line"
                         XValue="e => e.time"
                         YValue="e => e.price" />

    </ApexChart>
</div>
<p> test </p>
    
@code {
    private List<PriceData> Data { get; set; } = new();
    protected override void OnInitialized()
    {
        Data.Add(new PriceData{time = 0, price = 1});
        Data.Add(new PriceData{time = 1, price = 4});
        Data.Add(new PriceData{time = 2, price = 10});
        Data.Add(new PriceData{time = 3, price = 50});
        Data.Add(new PriceData{time = 4, price = 5});
        Data.Add(new PriceData{time = 5, price = 5});
        Data.Add(new PriceData{time = 6, price = 30});
        Data.Add(new PriceData{time = 7, price = 5});
        Data.Add(new PriceData{time = 8, price = 5});
    }
    
    public class PriceData
    {
        public int time { get; set; }
        public decimal price { get; set; }
    }
}
