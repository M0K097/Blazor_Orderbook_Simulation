@page "/"
@inherits LayoutComponentBase
@inject OrderBook orderbook
@rendermode InteractiveServer

<MudGrid>

    <MudItem xs="6">

        <MudStack Spacing="4">

            <MudPaper Class="pa-4" Style="width:100%; height:250px; overflow:auto;">
                <OrderInputFields when_create_order="handle_create_order"/>
            </MudPaper>

            <MudPaper Class="pa-4" Style="width:100%; height:300; overflow:auto;">
                <AutoPlacer on_auto_create="handle_create_order"/>
            </MudPaper>

        </MudStack>
                
    </MudItem>

    <MudItem xs="6">
        <MudPaper Style="width:100%; height:600px; overflow:auto;">
            <Book book=@orderbook />
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Style="width:100%;">
              <PriceChart @ref="pricechart"/>
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Style="width:100%;">
          <ExecutionTable executions="@orderbook.trade_log"/>
        </MudPaper>
    </MudItem>

</MudGrid>


@code {

    private PriceChart? pricechart;
    private decimal last_execution_price {get;set;} = 0;

    protected override void OnInitialized() => orderbook.trade_happened += update_graph;

    public void handle_create_order(OrderInput input)
    {
        var i = input;
        if(i.Type == OrderType.Limit)
        {
            orderbook.place_limit_order(i.side,i.Quantity,i.Price);
            Snackbar.Add("The reactor is running at optimum temperature");
        }
        else if(i.Type == OrderType.Market)
            orderbook.place_market_order(i.side,i.Quantity);
    }

    public async void update_graph()
    {
        if(orderbook.trade_log.Count > 0)
        {
            var last_trade = orderbook.trade_log.Last();
            await pricechart!.add_datapoint(last_trade.execution_price);
        }
    }
}
