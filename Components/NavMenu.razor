@inject NavigationManager NavManager

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
    <MudNavLink Href="/Docs" Match="NavLinkMatch.Prefix">Docs</MudNavLink>
    <MudIconButton Icon="@Icons.Custom.Brands.GitHub" @onclick="OpenGitHub" Color="Color.Primary" aria-label="github" />
</MudNavMenu>

@code {
    void OpenGitHub()
    {
        NavManager.NavigateTo("https://github.com/M0K097/Blazor_Orderbook_Simulation", forceLoad: true);
    }
}
