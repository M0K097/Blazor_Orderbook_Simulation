@rendermode InteractiveServer
@using ApexCharts

    <ApexChart TItem="PriceData"
               Title="Price" 
               options="options"
               OnZoomed="zoomed"
               @ref="chart"
               Width="@("100%")"
               Height="500" >

        <ApexPointSeries TItem="PriceData"
                         Items="Data"
                         Name="Price"
                         SeriesType="SeriesType.Line"
                         XValue="e => e.time"
                         YValue="e => Math.Round(e.price,2)" />

    </ApexChart>
    
@code {
    
    [Parameter]
    public EventCallback is_zoomed {get;set;}
    
    private List<PriceData> Data { get; set; } = new();
    private ApexChart<PriceData>? chart; 
    private int time_counter = 0;

    public async Task add_datapoint(decimal price_value)
    {
        var datapoint = new PriceData(price_value,time_counter);
        Data.Add(datapoint);
        if(chart != null)
            await chart.UpdateSeriesAsync();

        time_counter++;
    }

    private async void zoomed() => await is_zoomed.InvokeAsync();

    private ApexCharts.ApexChartOptions<PriceData> options = new()
    {
    Chart = new ApexCharts.Chart
    {
        Animations = new ApexCharts.Animations
        {
            Enabled = false
        },
        Toolbar = new ApexCharts.Toolbar
        {
            Show = true
        },
        Zoom = new Zoom
        {
            Enabled = true
        },
    },
    Tooltip = new ApexCharts.Tooltip
    {
        Enabled = true
    }
};

    public class PriceData
    {
        public decimal price {get;set;}
        public int time {get;set;}

        public PriceData(decimal price, int time)
        {
            this.price = price;
            this.time = time;
        }
    }
}
