@rendermode InteractiveServer
@using ApexCharts

<div>
    <ApexChart TItem="PriceData"
               Title="Price Chart" 
               @ref="chart"
               Width="600"
               Height="600" >

        <ApexPointSeries TItem="PriceData"
                         Items="Data"
                         Name="Price"
                         SeriesType="SeriesType.Line"
                         XValue="e => e.time"
                         YValue="e => e.price" />

    </ApexChart>
</div>
    
@code {

    [Parameter]
    public List<PriceData> Data { get; set; } = new(); 
    int c = 0;
    decimal p = 0;

    private ApexChart<PriceData>? chart; 

    public async Task add()
    {
        Data.Add(new PriceData{price=p,time=c});
        c++;
        p += 10;
        if(chart != null)
            await chart.UpdateSeriesAsync();
    }

    public class PriceData
    {
        public decimal price {get;set;}
        public int time {get;set;}
    }
}
