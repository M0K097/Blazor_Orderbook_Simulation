@rendermode InteractiveServer
@using ApexCharts

    <ApexChart TItem="PriceData"
               Title="Price" 
               options="options"
               @ref="chart"
               Width="@("100%")"
               Height="500" >

        <ApexPointSeries TItem="PriceData"
                         Items="Data"
                         Name="Price"
                         SeriesType="SeriesType.Line"
                         XValue="e => e.time"
                         YValue="e => e.price" />

    </ApexChart>
    
@code {

    [Parameter]
    public List<PriceData> Data { get; set; } = new(); 
    private ApexChart<PriceData>? chart; 
    private int time_counter = 0;

    public async Task add_datapoint(decimal price_value)
    {
        var datapoint = new PriceData(price_value,time_counter);
        Data.Add(datapoint);
        if(chart != null)
            await chart.UpdateSeriesAsync();

        time_counter++;
    }


    private ApexCharts.ApexChartOptions<PriceData> options = new()
    {
    Chart = new ApexCharts.Chart
    {
        Animations = new ApexCharts.Animations
        {
            Enabled = false
        },
        Toolbar = new ApexCharts.Toolbar
        {
            Show = false
        },
    },

    Stroke = new ApexCharts.Stroke
    {
        Curve = ApexCharts.Curve.Straight,
        Width = 2
    },
    Tooltip = new ApexCharts.Tooltip
    {
        Enabled = false
    },
    Grid = new ApexCharts.Grid
    {
        BorderColor = "#e0e0e0"
    }
};
 

    public class PriceData
    {
        public decimal price {get;set;}
        public int time {get;set;}

        public PriceData(decimal price, int time)
        {
            this.price = price;
            this.time = time;
        }
    }
}
