<h3> CREATE ORDER </h3>

    <MudToggleGroup T="OrderType" SelectionMode="SelectionMode.SingleSelection" @bind-Value="model.Type" Color="Color.Primary" CheckMark FixedContent>
        <MudToggleItem Value="@(OrderType.Limit)" Text="LIMIT" />
        <MudToggleItem Value="@(OrderType.Market)" Text="MARKET" />
    </MudToggleGroup>

    <MudNumericField @bind-Value="model.Quantity" Label="Standard" Variant="Variant.Outlined" Min="1m" Max="1000m" />
    @if(model.Type == OrderType.Limit)
    {
        <MudNumericField @bind-Value="model.Price" Label="Standard" Variant="Variant.Outlined" Min="0.01m" Max="10000m" />
    }
    <MudButton Variant="Variant.Filled" OnClick="create_new_buy_order" Size="Size.Large" Color="Color.Primary">BUY</MudButton>
    <MudButton Variant="Variant.Filled" OnClick="create_new_sell_order" Size="Size.Large" Color="Color.Secondary">SELL</MudButton>

@code
{
    [Parameter]
    public EventCallback<OrderInput> when_create_order {get;set;}

    private OrderInput model = new();

    public async Task create_new_buy_order() 
    {
        model.side = Side.buy;
        await when_create_order.InvokeAsync(model);
    }

    public async Task create_new_sell_order() 
    {
        model.side = Side.sell;
        await when_create_order.InvokeAsync(model);
    }
}
