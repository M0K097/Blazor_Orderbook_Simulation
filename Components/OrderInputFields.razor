@using System.ComponentModel.DataAnnotations

<h3> CREATE ORDER </h3>

<EditForm Model="model" OnValidSubmit="create_new_order">

    <DataAnnotationsValidator />

    <InputRadioGroup @bind-Value="model.side">
        <div>
        <label>SIDE:</label>
        <label>
            <InputRadio Value="Side.buy" />
            BUY
        </label>
        <label>
            <InputRadio Value="Side.sell" />
            SELL
        </label>
    </div>
    </InputRadioGroup>

    <InputRadioGroup @bind-Value="model.Type">
        <div>
        <label>TYPE:</label>
        <label>
            <InputRadio Value="OrderType.Limit" />
            Limit
        </label>
        <label>
            <InputRadio Value="OrderType.Market" />
            Market
        </label>
    </div>
    </InputRadioGroup>
    <div class="d-flex align-items-center">
        <label>Amount</label>
        <InputNumber @bind-Value="model.Quantity"/>
        <ValidationMessage For="@(() => model.Quantity)"/>

    @if(model.Type == OrderType.Limit)
    {
            <label>Price</label>
            <InputNumber @bind-Value="model.Price"/>
            <ValidationMessage For="@(() => model.Price)"/>
    }

</div>

<button>CREATE</button>

</EditForm>

@code
{
    [Parameter]
    public EventCallback<OrderInput> when_create_order {get;set;}

    private OrderInput model = new();

    public async Task create_new_order() => await when_create_order.InvokeAsync(model);
}
