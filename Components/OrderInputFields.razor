
<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-0">

    <MudStack Spacing="1">
        
        <MudText Typo="Typo.h5"> CREATE ORDERS </MudText>

        <MudRadioGroup @bind-Value="model.Type" Class="big-radio">
            <MudRadio Value="OrderType.Limit" Color="Color.Primary">Limit</MudRadio>
            <MudRadio Value="OrderType.Market" Color="Color.Secondary">Market</MudRadio>
        </MudRadioGroup>

        <MudStack Row="true" Spacing="1">
            <MudNumericField @bind-Value="model.Quantity" Label="Amount" Style="flex:1; min-width:0;"  Variant="Variant.Outlined" Min="1m" Max="1000m" />
            <MudNumericField @bind-Value="model.Price" Label="Price" Style="flex:1; min-width:0;" Variant="Variant.Outlined" Min="0.01m" Max="10000m" Disabled="@(model.Type != OrderType.Limit)"/>
        </MudStack>

        <MudStack Row="true" Class="mt-3">

            <MudButton Variant="Variant.Filled" OnClick="create_new_buy_order" Size="Size.Large" Style="flex:1;"  Color="Color.Tertiary">BUY</MudButton>
            <MudButton Variant="Variant.Filled" OnClick="create_new_sell_order" Size="Size.Large" Style="flex:1;" Color="Color.Secondary">SELL</MudButton>

        </MudStack>

    </MudStack>

</MudContainer>

@code
{
    [Parameter]
    public EventCallback<OrderInput> when_create_order {get;set;}

    private OrderInput model = new();

    public async Task create_new_buy_order() 
    {
        model.side = Side.buy;
        await when_create_order.InvokeAsync(model);
    }

    public async Task create_new_sell_order() 
    {
        model.side = Side.sell;
        await when_create_order.InvokeAsync(model);
    }
}
