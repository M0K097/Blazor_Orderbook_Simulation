
<MudGrid>
    <MudItem xs="6">
        <MudStack>

            <MudSlider @bind-Value="@Speed" min="10" max="5000">Speed: @Speed.ToString()</MudSlider>
            <MudSlider @bind-Value="@MaxPrice" min="1" max="10000">Maximal Price: @MaxPrice.ToString()</MudSlider>
            <MudSlider @bind-Value="@MaxAmount" min="1" max="10000">Maximal Amount: @MaxAmount.ToString()</MudSlider>

        </MudStack>
    </MudItem>
    
    <MudItem xs="6">
        <MudStack>

            <MudSlider @bind-Value="@Optimism" min="0" step="0.1" max="1">Otimism: @Optimism.ToString()</MudSlider>
            <MudSlider @bind-Value="@Variance" min="0" step="0.1" max="1">Variance: @Variance.ToString()</MudSlider>
            <MudSlider @bind-Value="@Liquidity" min="0" step="0.1" max="1">Variance: @Liquidity.ToString()</MudSlider>

        </MudStack>
    </MudItem>

    <MudItem xs="12">
        <MudStack Row="true" Justify="Justify.Center">
        @if(!IsRunning)
        {
            <MudButton Variant="Variant.Filled" OnClick="Start" Size="Size.Large" Style="flex:1;"  Color="Color.Primary">START</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" OnClick="Stop" Size="Size.Large" Color="Color.Secondary">STOP</MudButton>
        }
        
        </MudStack>
    </MudItem>
</MudGrid>

@code
{
    [Parameter]
    public EventCallback<OrderInput> on_auto_create {get;set;}

    private bool IsRunning = false;

    Worker? loop_worker {get;set;}

    public int Speed = 1000;
    public decimal MaxPrice {get;set;} = 100;
    public decimal MaxAmount {get;set;} = 100;
    public double Optimism {get;set;} = 0.5; 
    public double Variance {get; set;} = 0.1;
    public double Liquidity {get; set;} = 0.5;
    public decimal Min = 1;

    private Random random = new Random();

    public OrderInput make_input()
    {
        OrderInput input = new();
        input.Price = Min + (decimal)random.NextDouble() * (MaxPrice - Min);
        input.Quantity = Min + (decimal)random.NextDouble() * (MaxAmount - Min);
        input.Type = OrderType.Limit;
        var side_chance = random.Next(0,100);
        if(side_chance < Optimism * 100)
            input.side = Side.buy;
        else
            input.side = Side.sell;

        return input;
    }

    public async Task for_worker()
    {
        var o = make_input();
        await on_auto_create.InvokeAsync(o);
        Console.WriteLine("test");
        Console.WriteLine(o.Price);
    } 
    
    protected override void OnInitialized() => loop_worker = new Worker(for_worker);

    public void Stop()
    {
        if(loop_worker != null)
            loop_worker.Stop();
            IsRunning = false;
    }
    
    public void Start()
    {
        if(loop_worker != null)
            loop_worker.Start();
            IsRunning = true;
    }
}
