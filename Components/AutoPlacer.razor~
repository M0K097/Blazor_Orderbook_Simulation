
<MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.h5"> AUTOMATIC ORDER PLACEMENT </MudText>
</MudStack>

<MudGrid>
    <MudItem xs="6">
        <MudStack>

            @if(loop_worker is not null)
            {
                <MudSlider @bind-Value="@loop_worker.Speed" min="10" max="5000">Speed: @loop_worker.Speed.ToString()</MudSlider>
            }
            <MudSlider @bind-Value="@MaxPrice" min="1" max="1000" Variant="Variant.Filled" Color="Color.Error">Maximal Price: @MaxPrice.ToString()</MudSlider>
            <MudSlider @bind-Value="@MaxAmount" min="1" max="1000" Variant="Variant.Filled" Color="Color.Error">Maximal Amount: @MaxAmount.ToString()</MudSlider>

        </MudStack>
    </MudItem>
    
    <MudItem xs="6">
        <MudStack>

            <MudSlider @bind-Value="@Optimism" min="0" step="0.1" max="1" Variant="Variant.Filled">Otimism: @Optimism.ToString()</MudSlider>
            <MudSlider @bind-Value="@Variance" min="0" step="0.1" max="1" Variant="Variant.Filled">Variance: @Variance.ToString()</MudSlider>
            <MudSlider @bind-Value="@Liquidity" min="0" step="0.1" max="1" Variant="Variant.Filled">Liquidity: @Liquidity.ToString()</MudSlider>

        </MudStack>
    </MudItem>

    <MudItem xs="12">
        <MudStack Justify="Justify.Center" Row="true" AlignItems="AlignItems.Center">

        @if(!IsRunning)
        {
            <MudButton Variant="Variant.Filled" OnClick="Start" Size="Size.Large" Color="Color.Primary">START</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" OnClick="Stop" Size="Size.Large" Color="Color.Secondary">STOP</MudButton>
            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
        }
        
        </MudStack>
    </MudItem>
</MudGrid>

@code
{
    [Parameter]
    public EventCallback<OrderInput> on_auto_create {get;set;}

    private bool IsRunning = false;

    Worker? loop_worker {get;set;}

    public decimal MaxPrice {get;set;} = 100;
    public decimal MaxAmount {get;set;} = 100;
    public double Optimism {get;set;} = 0.5; 
    public double Variance {get; set;} = 0.1;
    public double Liquidity {get; set;} = 0.5;
    public decimal Min = 1;

    private Random random = new Random();

    private decimal last_price;

    public OrderInput make_input()
    {
        OrderInput input = new();
        
        var p = generate_price();
        input.Price = p;
        last_price = p;

        input.Quantity = Min + (decimal)random.NextDouble() * (MaxAmount - Min);

        var type_chance = random.Next(0,100); 
        if(type_chance < Liquidity * 100)
            input.Type = OrderType.Limit;
        
        var side_chance = random.Next(0,100);
        if(side_chance < Optimism * 100)
            input.side = Side.buy;
        else
            input.side = Side.sell;

        return input;
    }

    public async Task for_worker()
    {
        var o = make_input();
        await on_auto_create.InvokeAsync(o);
        Console.WriteLine($"automatic order created {o.Type}");
    } 

    private decimal generate_price()
    {
        decimal price = last_price;
        var max_possible_variance = MaxPrice * (decimal)Variance;
        var applied_variance = (decimal)random.NextDouble() * max_possible_variance;

        var direction = random.Next(100); 
        if(direction < 50)
            price -= applied_variance;
        else
            price += applied_variance;
        
        if(price < Min)
            price = Min;
        else if(price > MaxPrice)
            price = MaxPrice;

        Console.WriteLine($"created price from last_price:{last_price}  applied_variance:{applied_variance} RESULT ==> {price}");

        return price;
    }
    
    protected override void OnInitialized()
    {
        loop_worker = new Worker(for_worker);
        last_price = (Min + MaxPrice) / 2;
    }

    public void Stop()
    {
        if(loop_worker != null)
        {
            loop_worker.Stop();
            IsRunning = false;
        }
    }
    
    public void Start()
    {
        if(loop_worker != null)
        {
            loop_worker.Start();
            IsRunning = true;
        }
    }
}
