
<h3>Automatic Order Generator</h3>

<label>Speed: @Speed</label>
<div>
<input type="range"
        min="100"
        max="5000"
        @bind="Speed"
        @bind:event="oninput"/>
</div>

<label>Maximal Price: @MaxPrice</label>
<div>
    <input type="range"
            min="1"
            max="1000000"
            @bind="MaxPrice"
            @bind:event="oninput"/>
</div>


<label>Maximal Amount: @MaxAmount</label>
<div>
<input type="range"
        min="1"
        max="10000"
        @bind="MaxAmount"
        @bind:event="oninput"/>
</div>

<label>Optimism: @Optimism</label>
<div>
<input type="range"
        min="0"
        max="1"
        step="0.01"
        @bind="Optimism"
        @bind:event="oninput"/>
</div>

<label>Variance: @Variance</label>
<div>
<input type="range"
        min="0"
        max="1"
        step="0.01"
        @bind="Variance"
        @bind:event="oninput"/>
</div>

<button @onclick="Start">test_start</button>

@code
{
    [Parameter]
    public EventCallback<OrderInput> on_auto_create {get;set;}

    public int Speed {get;set;} = 1000;
    public decimal MaxPrice {get;set;} = 100;
    public decimal MaxAmount {get;set;} = 100;
    public double Optimism {get;set;} = 0.5; 
    public double Variance {get; set;} = 0.5;

    public async Task for_worker()
    {
        OrderInput o = new();
        o.Price = 100m;
        o.Quantity = 100m;
        o.Type = OrderType.Limit;
        o.side = Side.buy;

        await on_auto_create.InvokeAsync(o);
        Console.WriteLine("test");
        Console.WriteLine(o.price);
    } 
    
    Worker? loop_worker {get;set;}

    protected override void OnInitialized()
    {
        loop_worker = new Worker(for_worker);
    }
    
    public void Start()
    {
        if(loop_worker != null)
            loop_worker.Start();
    }


}
