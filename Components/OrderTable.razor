
@if(orders is not null)
{
    <table class="@CssClass table-shadow">
        @if(show_head)
        {
            <thead>
                <tr>
                    <th>ID</th>
                    <th>AMOUNT</th>
                    <th>PRICE</th>
                    <th>STATUS</th>
                    <th>FILLED</th>
                    <th>REMAINING</th>
                </tr>
            </thead>
        }
        <tbody>
            @foreach(var o in orders.TakeLast(10))
            {
                <tr>
                    <td>@o.order_id</td>
                    <td>@o.quantity</td>
                    <td>@o.price</td>
                    <td>@o.status</td>
                    <td>@o.filled</td>
                    <td>@o.remaining</td>
               </tr>
            }
        </tbody>
    </table>
}

@code
{
    [Parameter]
    public List<LimitOrder>? orders {get;set;}

    [Parameter]
    public bool show_head {get;set;} = true;

    [Parameter] 
    public string CssClass { get; set; } = "";
}
  
