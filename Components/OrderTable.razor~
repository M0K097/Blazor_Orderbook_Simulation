
@if(orders is not null)
{
    <table class="@CssClass">
        <thead>
            <tr>
                <th>ID</th>
                <th>AMOUNT</th>
                <th>PRICE</th>
                <th>FILL</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var o in orders.TakeLast(10))
            {
                <tr>
                    <td>@o.order_id</td>
                    <td>@o.quantity</td>
                    <td>@o.price</td>
                    <td>@o.filled</td>
               </tr>
            }
        </tbody>
    </table>
}

@code
{
    [Parameter]
    public List<LimitOrder>? orders {get;set;}
}
  
