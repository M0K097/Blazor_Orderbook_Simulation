@inject NavigationManager Nav

<MudStack Row="true">
    <MudText Typo="Typo.h5">ASKS</MudText><MudButton OnClick="show_all_asks">show all</MudButton>
</MudStack>
<OrderTable orders="@book.ASKS.AsEnumerable().Reverse().ToList()" CssClass="table-light-red"/>

@if(book.trade_log.Count > 0)
{
    @if(last_execution_price < book.trade_log.Last().execution_price)
    {
        <MudText Typo="Typo.h5" Color="Color.Success"> @book.trade_log.Last().execution_price.ToString("0.00") </MudText>
    }
    else
    {
        <MudText Typo="Typo.h5" Color="Color.Error"> @book.trade_log.Last().execution_price.ToString("0.00") </MudText>
    }
    last_execution_price = @book.trade_log.Last().execution_price;
}

<MudStack Row="true">
    <MudText Typo="Typo.h5">BIDS</MudText><MudButton OnClick="show_all_bids">show all</MudButton>
</MudStack>
<OrderTable orders="@book.BIDS" show_head="false" CssClass="table-light-green"/>

@code {
    [Parameter]
    public OrderBook book {get;set;} = null!; 

    private decimal last_execution_price {get;set;} = 0;

    public void show_all_bids() => Nav.NavigateTo("/BIDS");

    public void show_all_asks() => Nav.NavigateTo("/ASKS");
}
