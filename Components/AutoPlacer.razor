
<h3>Automatic Order Generator</h3>


<MudGrid>
    <MudItem xs="6">
        <MudSlider @bind-Value="@Speed" min="100" max="10000">Speed: @Speed.ToString()</MudSlider>

<label>Maximal Price: @MaxPrice</label>

    <input type="range"
            min="1"
            max="1000000"
            @bind="MaxPrice"
            @bind:event="oninput"/>
    </MudItem>
    <MudItem xs="6">


<label>Maximal Amount: @MaxAmount</label>
<input type="range"
        min="1"
        max="10000"
        @bind="MaxAmount"
        @bind:event="oninput"/>


<label>Optimism: @Optimism</label>

<input type="range"
        min="0"
        max="1"
        step="0.01"
        @bind="Optimism"
        @bind:event="oninput"/>

    </MudItem>

    <MudItem xs="6">

<label>Variance: @Variance</label>
<input type="range"
        min="0"
        max="1"
        step="0.01"
        @bind="Variance"
        @bind:event="oninput"/>

@if(!IsRunning)
{
    <button @onclick="Start">START</button>
}
else
{
    <button @onclick="Stop">STOP</button>
}
    </MudItem>

</MudGrid>

@code
{
    [Parameter]
    public EventCallback<OrderInput> on_auto_create {get;set;}

    private bool IsRunning = false;

    Worker? loop_worker {get;set;}

    public int Speed = 1000;
    public decimal MaxPrice {get;set;} = 100;
    public decimal MaxAmount {get;set;} = 100;
    public double Optimism {get;set;} = 0.5; 
    public double Variance {get; set;} = 0.1;
    public decimal Min = 1;

    private Random random = new Random();

    public OrderInput make_input()
    {
        OrderInput input = new();
        input.Price = Min + (decimal)random.NextDouble() * (MaxPrice - Min);
        input.Quantity = Min + (decimal)random.NextDouble() * (MaxAmount - Min);
        input.Type = OrderType.Limit;
        var side_chance = random.Next(0,100);
        if(side_chance < Optimism * 100)
            input.side = Side.buy;
        else
            input.side = Side.sell;

        return input;
    }

    public async Task for_worker()
    {
        var o = make_input();
        await on_auto_create.InvokeAsync(o);
        Console.WriteLine("test");
        Console.WriteLine(o.Price);
    } 
    
    protected override void OnInitialized() => loop_worker = new Worker(for_worker);

    public void Stop()
    {
        if(loop_worker != null)
            loop_worker.Stop();
            IsRunning = false;
    }
    
    public void Start()
    {
        if(loop_worker != null)
            loop_worker.Start();
            IsRunning = true;
    }
}
