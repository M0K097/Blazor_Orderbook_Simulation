
<h3>Automatic Order Generator</h3>

<div>
    <label>
        <input type="checkbox"
               @bind="IsRunning"/>
        IsRunning
    </label>
</div>

<label>Speed: @Speed</label>
<div>
<input type="range"
        min="100"
        max="5000"
        @bind="Speed"
        @bind:event="oninput"/>
</div>

<label>Maximal Price: @MaxPrice</label>
<div>
    <input type="range"
            min="1"
            max="1000000"
            @bind="MaxPrice"
            @bind:event="oninput"/>
</div>


<label>Maximal Amount: @MaxAmount</label>
<div>
<input type="range"
        min="1"
        max="10000"
        @bind="MaxAmount"
        @bind:event="oninput"/>
</div>

<label>Optimism: @Optimism</label>
<div>
<input type="range"
        min="0"
        max="1"
        step="0.01"
        @bind="Optimism"
        @bind:event="oninput"/>
</div>

<label>Variance: @Variance</label>
<div>
<input type="range"
        min="0"
        max="1"
        step="0.01"
        @bind="Variance"
        @bind:event="oninput"/>
</div>

@code
{
    public bool IsRunning {get;set;} = false;
    public int Speed {get;set;} = 1000;
    public decimal MaxPrice {get;set;} = 100;
    public decimal MaxAmount {get;set;} = 100;
    public double Optimism {get;set;} = 0.5; 
    public double Variance {get; set;} = 0.5;
}
